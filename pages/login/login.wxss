page {
  background: #1e1a15;
  font-family: "KaiTi", "STKaiti", serif;
}

.page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 48rpx 60rpx;
  overflow: hidden;
  background: linear-gradient(168deg, #211d18 0%, #342a1f 52%, #191612 100%);
  color: #f0dcae;
}

.page-skip {
  background: #E8F4F8;
}

.bg-glow {
  position: absolute;
  top: -220rpx;
  left: 50%;
  width: 760rpx;
  height: 760rpx;
  margin-left: -380rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(217, 185, 108, 0.2) 0%, rgba(217, 185, 108, 0) 68%);
}

.bg-ring {
  position: absolute;
  right: -260rpx;
  bottom: -200rpx;
  width: 620rpx;
  height: 620rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(217, 185, 108, 0.12);
}

.status-seat {
  width: 100%;
}

.content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ===== 品牌区 ===== */
.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 72rpx;
}

.seal {
  width: 118rpx;
  height: 118rpx;
  border: 4rpx solid #c0392b;
  border-radius: 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(192, 57, 43, 0.12);
  box-shadow: 0 0 32rpx rgba(192, 57, 43, 0.22);
  transform: rotate(-4deg);
}

.seal-char {
  color: #e05a42;
  font-size: 40rpx;
  line-height: 42rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}

.brand-title {
  margin-top: 30rpx;
  font-size: 58rpx;
  line-height: 1.2;
  letter-spacing: 10rpx;
  color: #f3e3bb;
  text-shadow: 0 4rpx 20rpx rgba(217, 185, 108, 0.28);
}

.brand-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  letter-spacing: 5rpx;
  color: rgba(240, 220, 174, 0.62);
}

.divider {
  width: 420rpx;
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(217, 185, 108, 0) 0%, rgba(217, 185, 108, 0.5) 100%);
}

.divider-line:last-child {
  background: linear-gradient(90deg, rgba(217, 185, 108, 0.5) 0%, rgba(217, 185, 108, 0) 100%);
}

.divider-dot {
  font-size: 18rpx;
  color: rgba(217, 185, 108, 0.8);
}

/* ===== 登录卡片 ===== */
.card {
  width: 100%;
  margin-top: 40rpx;
  box-sizing: border-box;
  padding: 40rpx 40rpx 36rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(217, 185, 108, 0.32);
  background: rgba(247, 242, 230, 0.06);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.28);
  display: flex;
  flex-direction: column;
}

.card-head {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-title {
  font-size: 38rpx;
  letter-spacing: 6rpx;
  color: #f3e3bb;
}

.card-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(240, 220, 174, 0.56);
}

.tabs {
  display: flex;
  margin-top: 32rpx;
  border-radius: 14rpx;
  padding: 6rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(217, 185, 108, 0.18);
}

.tab {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: rgba(240, 220, 174, 0.55);
}

.tab-active {
  background: rgba(217, 185, 108, 0.18);
  color: #f3e3bb;
  font-weight: bold;
}

.field {
  width: 100%;
  margin-top: 28rpx;
}

.field-label {
  font-size: 26rpx;
  letter-spacing: 3rpx;
  color: rgba(240, 220, 174, 0.8);
}

.field-box {
  margin-top: 12rpx;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(217, 185, 108, 0.3);
  background: rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
}

.field-input {
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
  color: #f7f2e6;
}

.field-input-flex {
  flex: 1;
  min-width: 0;
}

.field-placeholder {
  color: rgba(240, 220, 174, 0.38);
  font-size: 25rpx;
}

.eye {
  flex-shrink: 0;
  padding-left: 20rpx;
  font-size: 24rpx;
  color: rgba(217, 185, 108, 0.85);
}

.error-msg {
  width: 100%;
  margin-top: 20rpx;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(192, 57, 43, 0.16);
  border: 1rpx solid rgba(224, 90, 66, 0.4);
  font-size: 24rpx;
  line-height: 34rpx;
  color: #f0b3a3;
}

.primary-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 36rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  border: 1rpx solid rgba(240, 205, 130, 0.5);
  background: linear-gradient(100deg, #a63b2a 0%, #c85a3a 55%, #a63b2a 100%);
  color: #fff4dd;
  font-size: 32rpx;
  letter-spacing: 8rpx;
  box-shadow: 0 10rpx 26rpx rgba(166, 59, 42, 0.32);
}

.primary-btn::after {
  border: none;
}

.primary-btn-hover {
  opacity: 0.86;
  transform: translateY(2rpx);
}

.switch-tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 25rpx;
  letter-spacing: 2rpx;
  color: rgba(217, 185, 108, 0.8);
}

.or-line {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.or-line-inner {
  flex: 1;
  height: 1rpx;
  background: rgba(217, 185, 108, 0.2);
}

.or-text {
  font-size: 22rpx;
  color: rgba(240, 220, 174, 0.42);
}

.guest-btn {
  width: 100%;
  height: 82rpx;
  margin-top: 24rpx;
  border-radius: 42rpx;
  border: 1rpx solid rgba(217, 185, 108, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  letter-spacing: 3rpx;
  color: rgba(240, 220, 174, 0.82);
}

.guest-btn-hover {
  background: rgba(217, 185, 108, 0.12);
}

.notice {
  width: 100%;
  margin-top: 26rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 8rpx;
  font-size: 21rpx;
  line-height: 32rpx;
  color: rgba(240, 220, 174, 0.42);
  text-align: center;
}

.notice-mark {
  color: rgba(217, 185, 108, 0.6);
}

.footer {
  margin-top: 40rpx;
  padding-bottom: 20rpx;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: rgba(217, 185, 108, 0.38);
}
