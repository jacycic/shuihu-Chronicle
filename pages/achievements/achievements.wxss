page {
  background-color: #f7f2e6;
  background-image:
    linear-gradient(rgba(247, 242, 230, 0.88), rgba(247, 242, 230, 0.88)),
    url("https://shuihu2026.oss-cn-guangzhou.aliyuncs.com/img/other/background1.png");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.page {
  min-height: 100vh;
  padding: 36rpx 28rpx 80rpx;
  box-sizing: border-box;
}

.page-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.header-title {
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 52rpx;
  font-weight: bold;
  letter-spacing: 10rpx;
  color: #3b2f22;
}

.header-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: #9a8258;
}

.header-ornament {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 18rpx;
}

.ornament-line {
  width: 110rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(184, 134, 11, 0), rgba(184, 134, 11, 0.75));
}

.ornament-line.reverse {
  transform: rotate(180deg);
}

.ornament-dot {
  width: 10rpx;
  height: 10rpx;
  background: #b8860b;
  transform: rotate(45deg);
}

.card {
  border-radius: 28rpx;
  border: 1rpx solid rgba(184, 134, 11, 0.22);
  background: #fffdf7;
  box-shadow: 0 10rpx 30rpx rgba(90, 70, 40, 0.1);
}

/* 解锁概览 */
.summary-card {
  padding: 30rpx 28rpx;
  margin-bottom: 32rpx;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 26rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.summary-num {
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 46rpx;
  font-weight: bold;
  color: #3b2f22;
  line-height: 1.1;
}

.summary-num.highlight {
  color: #a8322a;
}

.summary-num.dim {
  color: #a08d6c;
}

.summary-label {
  font-size: 22rpx;
  color: #8a7658;
}

.summary-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(184, 134, 11, 0.25);
}

.progress-track {
  height: 14rpx;
  border-radius: 999rpx;
  background: #ede4cf;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #a8322a, #d9a441);
  transition: width 0.5s ease;
}

.progress-caption {
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9a8258;
}

/* 成就网格 */
.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  align-content: flex-start;
}

.achievement-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 22rpx 8rpx 18rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.achievement-item-hover {
  opacity: 0.85;
  transform: scale(0.97);
}

.achievement-item.unlocked {
  border: 1rpx solid rgba(184, 134, 11, 0.5);
  background: linear-gradient(180deg, #fffdf5, #fbf1d8);
  box-shadow: 0 6rpx 18rpx rgba(168, 50, 42, 0.12);
}

.achievement-item.locked {
  border: 1rpx dashed rgba(138, 118, 88, 0.4);
  background: rgba(255, 253, 247, 0.65);
}

.icon-area {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 14rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-area image {
  width: 100%;
  height: 100%;
}

.unlocked .icon-area {
  border: 1rpx solid rgba(184, 134, 11, 0.45);
  background: #fff8e1;
}

.locked .icon-area {
  border: 1rpx dashed rgba(138, 118, 88, 0.45);
  background: #f1ece0;
}

.lock-mark {
  font-size: 38rpx;
  font-family: "kaiTi", "STKaiti", serif;
  color: #b7a98e;
}

.text-area {
  font-size: 22rpx;
  line-height: 1.35;
  text-align: center;
  word-break: break-all;
}

.unlocked .text-area {
  font-weight: 600;
  color: #3b2f22;
}

.locked .text-area {
  color: #b0a48f;
  letter-spacing: 2rpx;
}

.unlocked-flag {
  position: absolute;
  top: -8rpx;
  right: -6rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #a8322a;
  color: #fff5e0;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(168, 50, 42, 0.3);
}
