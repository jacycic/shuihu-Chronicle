page {
  background-color: #f7f2e6;
  background-image:
    linear-gradient(rgba(247, 242, 230, 0.88), rgba(247, 242, 230, 0.88)),
    url("https://shuihu2026.oss-cn-guangzhou.aliyuncs.com/img/other/background1.png");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.page {
  min-height: 100vh;
  padding: 36rpx 32rpx 80rpx;
  box-sizing: border-box;
}

.page-header {
  text-align: center;
  margin-bottom: 36rpx;
}

.header-title {
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 52rpx;
  font-weight: bold;
  letter-spacing: 10rpx;
  color: #3b2f22;
}

.header-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: #9a8258;
}

.header-ornament {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 18rpx;
}

.ornament-line {
  width: 110rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(184, 134, 11, 0), rgba(184, 134, 11, 0.75));
}

.ornament-line.reverse {
  transform: rotate(180deg);
}

.ornament-dot {
  width: 10rpx;
  height: 10rpx;
  background: #b8860b;
  transform: rotate(45deg);
}

.card {
  margin-bottom: 28rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(184, 134, 11, 0.22);
  background: #fffdf7;
  box-shadow: 0 10rpx 30rpx rgba(90, 70, 40, 0.1);
}

/* 画像与基本信息 */
.profile-card {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.portrait-box {
  width: 200rpx;
  height: 220rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  border: 2rpx solid rgba(184, 134, 11, 0.45);
  background: linear-gradient(180deg, #fbf4e2, #f0e5cb);
  overflow: hidden;
}

.portrait-box image {
  width: 100%;
  height: 100%;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.hero-name {
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 56rpx;
  font-weight: bold;
  letter-spacing: 6rpx;
  color: #3b2f22;
}

.hero-nick {
  margin-top: 10rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: #a8322a;
}

.hero-star {
  margin-top: 12rpx;
  display: inline-block;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(184, 134, 11, 0.45);
  color: #9a7b32;
  font-size: 24rpx;
}

/* 五维进度条 */
.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 22rpx;
  margin-bottom: 26rpx;
  border-bottom: 1rpx solid rgba(184, 134, 11, 0.18);
}

.card-title {
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 34rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  color: #3b2f22;
}

.card-sub {
  font-size: 24rpx;
  color: #9a8258;
}

.score-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.score-row:last-child {
  margin-bottom: 0;
}

.score-label {
  width: 36rpx;
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 32rpx;
  font-weight: bold;
  color: #7a3b2a;
}

.score-track {
  flex: 1;
  height: 18rpx;
  border-radius: 999rpx;
  background: #ede4cf;
  overflow: hidden;
}

.score-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #a8322a, #d9a441);
  transition: width 0.5s ease;
}

.score-value {
  width: 58rpx;
  text-align: right;
  font-size: 26rpx;
  color: #5a4a33;
}

.primary-btn {
  margin-top: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #8f2c22, #b8860b);
  color: #fff6e2;
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 32rpx;
  letter-spacing: 6rpx;
  box-shadow: 0 12rpx 28rpx rgba(143, 44, 34, 0.25);
}

.primary-btn-hover {
  opacity: 0.88;
}

/* 空态 */
.empty-card {
  margin-top: 60rpx;
  text-align: center;
  padding: 60rpx 40rpx;
}

.empty-mark {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(184, 134, 11, 0.5);
  color: #b8860b;
  font-size: 48rpx;
  line-height: 96rpx;
}

.empty-title {
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 36rpx;
  font-weight: bold;
  color: #3b2f22;
}

.empty-desc {
  margin: 16rpx 0 36rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #8a7658;
}
