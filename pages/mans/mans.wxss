/* 顶部：文字 + 人物图 横向布局 */
.hero-top-area {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  padding-top: 40rpx;
}

.hero-info-text {
  flex: 1;
  margin-right: 20rpx;
}

/* 人物图画框 */
.hero-img-frame {
  position: fixed;
  top: 2rpx;
  right: 2rpx;
  width: 240rpx;
  height: 320rpx;
  border: 4rpx solid #6b2814;
  border-radius: 12rpx 0 0 12rpx;
  padding: 10rpx;
  background-color: #fff9e8;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
  z-index: 999;
}

.hero-img-frame image {
  
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
  display: block;
}

/* 每一行文字 */
.info-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: #442211;
  border-bottom: 1rpx dashed #e2d9cc;
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  width: 120rpx;
  font-weight: bold;
  color: #6b2814;
}

/* 属性区域 */
.attr-panel {
  margin: 120rpx 0rpx 30rpx;
  padding: 20rpx 30rpx;
  background-color: #fbf6ea;
  border-radius: 16rpx;
  
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}