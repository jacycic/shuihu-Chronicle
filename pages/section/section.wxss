page{
  background-image: url("https://shuihu2026.oss-cn-guangzhou.aliyuncs.com/img/other/background1.png");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  background-attachment: fixed;
  /* 禁止页面滚动！核心 */
  overflow: hidden;
  height: 100vh;
}

/* 外层改成纵向弹性布局，整屏分配空间 */
page{
  display: flex;
  flex-direction: column;
}

.ctrl{
  height:100vh ;
  display: flex;
  flex-direction: column;
  justify-content:center;
  align-items:center;
  font-family: "KaiTi",serif;
  font-size: 36rpx;
}

.text{
  margin-bottom:60rpx;
  font-size:38rpx;
  color:#222;
  padding:0 40rpx;
  text-align:center;
}

.answer{
  display: flex;
  gap:40rpx;     /* 两个答案之间的间距 */
  margin-bottom:40rpx; /* 两行选项之间的间距 */
}

/* 合并 answer-1 answer-2 公共样式，不用重复写 */
.answer-item{
  display: flex;
  background-image: radial-gradient(circle,#64C2CC,#1DACDB);
  border-radius: 15rpx;
  height: 200rpx;
  width: 320rpx;
  align-items: center;  /* 垂直居中 */
  justify-content:center; /* 水平居中 */
  color:#fff;
  border: 2rpx solid gray;
  
}
/* 点击按下效果 */
.answer-item:active{
  opacity:0.75;
}

/* 顶部输入区域样式 */
.input-wrap{
  display:flex;
  gap:20rpx;
  padding:40rpx 30rpx;
  align-items:center;
  flex-shrink: 0;
}
.hero-input{
  flex:1;
  border:2rpx solid #1DACDB;
  border-radius:12rpx;
  padding:20rpx;
  font-size:30rpx;
  
}
.jump-btn{
  background:#1DACDB;
  color:#fff;
  margin:0;
  border-radius:12rpx;
  padding:20rpx 30rpx;
  border: 2rpx solid gray;
}
.jump-btn::after{
  border:none;
}

.ctrl{
  /* 不再写 height:100vh！！ */
  flex: 1; /* 占据输入框剩下的全部剩余空间 */
  display: flex;
  flex-direction: column;
  justify-content:center;
  align-items:center;
  font-family: "KaiTi",serif;
  font-size: 36rpx;
}

