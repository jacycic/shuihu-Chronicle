.container{
  padding: 40rpx;
}
.title{
  font-size:36rpx;
  font-weight:bold;
  margin-bottom:30rpx;
}
.scene-item{
  padding:30rpx;
  border:1rpx solid #ccc;
  border-radius:12rpx;
  margin-bottom:20rpx;
  display:flex;
  justify-content:space-between;
  align-items:center;
}
.dialog-mask{
  position: fixed;
  left:0;
  top:0;
  width:100%;
  height:100%;
  background:rgba(0,0,0,0.5);
  display:flex;
  align-items:center;
  justify-content:center;
  z-index:99;
}
.dialog-wrap{
  width:85%;
  background:#fff8ec;
  border-radius:16rpx;
  padding:30rpx;
}
.intro-box{
  border:1rpx solid #d4c8b8;
  border-radius:12rpx;
  padding:20rpx;
  margin-bottom:20rpx;
}
.chat-box{
  border:1rpx solid #d4c8b8;
  border-radius:12rpx;
  padding:20rpx;
  min-height:600rpx;
}
.chat-content{
  height:520rpx;
}
.msg-left{
  display:flex;
  justify-content:flex-start;
  margin:16rpx 0;
}
.msg-right{
  display:flex;
  justify-content:flex-end;
  margin:16rpx 0;
}
.msg-bubble{
  max-width:70%;
  padding:16rpx 20rpx;
  border-radius:12rpx;
  font-size:28rpx;
}
.msg-bubble.npc{
  background:#e8e2d8;
}
.msg-bubble.user{
  background:#c85b3b;
  color:#fff;
}
.close-btn{
  margin-top:30rpx;
  background:#b84e2e;
  color:white;
}
.label{
  color:#888;
  font-size:24rpx;
}