<view class="container">
  <view class="title">对话测试页</view>
  <view wx:for="{{sceneList}}" wx:key="index" bindtap="openSceneDialog" data-index="{{index}}" class="scene-item">
    <text>{{item.name}}</text>
    <view wx:if="{{index>unlockIndex}}" class="lock-tag">🔒未解锁</view>
    <view wx:else class="lock-tag">✅已解锁</view>
  </view>
</view>

<!-- 场景弹窗 -->
<view wx:if="{{showDialog}}" class="dialog-mask" bindtap="closeDialog">
  <view class="dialog-wrap" bindtap="stopBubble">
    <!-- 介绍区 -->
    <view class="intro-box">
      <text class="label">介绍区</text>
      <view class="scene-name">{{currentSceneName}}</view>
      <view class="scene-desc">{{currentSceneText}}</view>
    </view>
    <!-- 聊天区：点击推进剧情 -->
    <view class="chat-box" bindtap="clickChatArea">
      <text class="label">聊天区（点击空白继续对话）</text>
      <scroll-view scroll-y class="chat-content">
        <view wx:for="{{chatList}}" wx:key="index">
          <view wx:if="{{item.type === 'npc'}}" class="msg-left">
            <view class="msg-bubble npc">{{item.text}}</view>
          </view>
          <view wx:else class="msg-right">
            <view class="msg-bubble user">{{item.text}}</view>
          </view>
        </view>
      </scroll-view>
    </view>
    <button class="close-btn" bindtap="closeDialog">关闭</button>
  </view>
</view>