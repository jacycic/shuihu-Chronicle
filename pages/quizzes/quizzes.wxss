.ctrl{
  height:100vh ;
  display: flex;
  flex-direction: column;
  justify-content:center;
  align-items:center;
  font-family: "KaiTi",serif;
  font-size: 36rpx;
  padding: 30rpx;
  box-sizing: border-box;
  /* 页面底色：淡蓝渐变背景，解决空白单调 */
  background: linear-gradient(180deg, #f0f8fb 0%, #d7f6fe 100%);
  position: relative;
  overflow: hidden;
}


/* 大文字背景装饰（水浒大字，虚化水印） */
.decor{
  position: absolute;
  font-size: 220rpx;
  color: rgba(26, 172, 219, 0.08);
  z-index: 0;
  user-select: none;
}
.decor-1{
  top:100rpx;
  left:-80rpx;
}
.decor-2{
  bottom:120rpx;
  right:-60rpx;
}
.decor-3{
  top:50%;
  right:40rpx;
}

.title-wrap{
  text-align:center;
  margin-bottom:30rpx;
}
.title{
  font-size:64rpx;
  color:#1DACDB;
  margin-bottom:10rpx;
}
.progress{
  font-size:28rpx;
  color:#777;
}

.text{
  margin-bottom:60rpx;
  font-size:38rpx;
  color:#222;
  padding:0 40rpx;
  text-align:center;
  line-height: 1.6;
}

.answer{
  display: flex;
  gap:40rpx;
  margin-bottom:40rpx;
}

.answer-item{
  display: flex;
  background-image: radial-gradient(circle,#64C2CC,#1DACDB);
  border-radius: 15rpx;
  height: 200rpx;
  width: 320rpx;
  align-items: center;
  justify-content:center;
  color:#fff;
  box-shadow: 0 6rpx 16rpx rgba(26,172,219,0.35);
  /* 轻微上浮效果，增加层次感 */
  transform: translateY(0);
  transition: all 0.2s;
}
.answer-item:active{
  opacity:0.75;
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 8rpx rgba(26,172,219,0.25);
}

/* 结果页样式 */
.result-wrap{
  display:flex;
  flex-direction:column;
  align-items:center;
  z-index:1;
}
.result-title{
  font-size:44rpx;
  color:#222;
  margin-bottom:40rpx;
}
.result-text{
  font-size:40rpx;
  margin-bottom:20rpx;
}
.score{
  color:#1DACDB;
  font-weight:bold;
  font-size:48rpx;
}
.tip{
  font-size:32rpx;
  color:#666;
  margin-bottom:20rpx;
}
.evaluate{
  font-size:34rpx;
  color:#1DACDB;
  margin-bottom:80rpx;
}
.restart-btn{
  background-image: radial-gradient(circle,#64C2CC,#1DACDB);
  color:#fff;
  padding:24rpx 60rpx;
  border-radius:15rpx;
  box-shadow: 0 6rpx 16rpx rgba(26,172,219,0.35);
}
.restart-btn:active{
  opacity:0.75;
}

/* 答题页脚：小知识进度 */
.quiz-foot{
  margin-top:18rpx;
  font-size:23rpx;
  color:#5b93a8;
  z-index:1;
}

/* 答题中途的小知识卡 */
.fact-mask{
  position:fixed;
  top:0;
  left:0;
  right:0;
  bottom:0;
  z-index:90;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:48rpx;
  box-sizing:border-box;
  background:rgba(12,46,62,0.58);
}
.fact-card{
  width:100%;
  max-height:86vh;
  overflow-y:auto;
  padding:36rpx 34rpx 34rpx;
  border-radius:24rpx;
  background:#f7fcfe;
  box-shadow:0 20rpx 60rpx rgba(10,60,80,0.3);
  box-sizing:border-box;
}
.fact-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:22rpx;
}
.fact-tag{
  padding:8rpx 22rpx;
  border-radius:999rpx;
  background:#d9f1fa;
  color:#187fa8;
  font-size:24rpx;
}
.fact-count{ font-size:24rpx; color:#8aa6b2; }
.fact-title{
  font-size:40rpx;
  font-weight:bold;
  color:#155f80;
  margin-bottom:18rpx;
}
.fact-text{
  font-size:29rpx;
  line-height:1.8;
  color:#33454d;
  margin-bottom:24rpx;
}
.fact-line{
  display:flex;
  align-items:flex-start;
  gap:16rpx;
  padding:20rpx;
  border-radius:16rpx;
  background:#eaf6fb;
  font-size:26rpx;
  line-height:1.7;
  color:#37657a;
}
.fact-label{
  flex-shrink:0;
  width:40rpx;
  height:40rpx;
  border-radius:50%;
  background:#1DACDB;
  color:#fff;
  font-size:22rpx;
  line-height:40rpx;
  text-align:center;
}
.fact-line-text{ flex:1; }
.fact-source{ margin-top:18rpx; font-size:22rpx; color:#8aa6b2; }
.fact-hint{
  margin-top:24rpx;
  padding:18rpx 20rpx;
  border-radius:14rpx;
  border:1rpx dashed #e0b45f;
  background:#fff8e8;
  font-size:24rpx;
  line-height:1.6;
  color:#8a6520;
}
.fact-btn{
  margin-top:30rpx;
  height:84rpx;
  line-height:84rpx;
  text-align:center;
  border-radius:999rpx;
  background:linear-gradient(90deg,#1a7fb5,#1DACDB);
  color:#fff;
  font-size:30rpx;
  letter-spacing:4rpx;
}
.fact-btn:active{ opacity:0.85; }

/* 结果页：本局新解锁成就 */
.unlock-text{
  margin:-36rpx 0 40rpx;
  font-size:27rpx;
  line-height:1.6;
  color:#187fa8;
  text-align:center;
}