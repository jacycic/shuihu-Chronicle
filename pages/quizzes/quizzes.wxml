<view class="ctrl">
  <globaltips id="unlockTipRef"></globaltips>

  <!-- 背景装饰元素 -->
  <view class="decor decor-1">水</view>
  <view class="decor decor-2">浒</view>
  <view class="decor decor-3">传</view>

  <view wx:if="{{!isFinish}}">
    <view class="title-wrap">
      <view class="title">第{{current + 1}}题 / 共{{total}}题</view>
      <view class="progress">进度 {{current+1}}/{{total}}</view>
    </view>
    <view class="text">{{questionList[current].title}}</view>

    <view class="answer" bind:tap="SectionSound">
      <view class="answer-item" bindtap="selectAnswer" data-idx="0">
        {{questionList[current].opt[0]}}
      </view>
      <view class="answer-item" bindtap="selectAnswer" data-idx="1">
        {{questionList[current].opt[1]}}
      </view>
    </view>
    <view class="quiz-foot">小知识 {{factReadCount}}/{{factTotal}} · 每答 5 题读到一条，可解锁成就</view>
  </view>

  <!-- 答题结束 得分页 -->
  <view wx:else class="result-wrap">
    <view class="result-title">答题结束！</view>
    <view class="result-text">你的得分：<text class="score">{{score}}</text> 分</view>
    <view class="tip">满分：{{fullScore}}分</view>
    <view class="evaluate">{{evaluateText}}</view>
    <view wx:if="{{unlockedText}}" class="unlock-text">{{unlockedText}}</view>
    <view class="restart-btn" bindtap="restartQuiz">重新答题</view>
  </view>

  <!-- 答题中途的小知识卡 -->
  <view wx:if="{{factVisible && fact}}" class="fact-mask" catchtap="noop">
    <view class="fact-card" catchtap="noop">
      <view class="fact-head">
        <text class="fact-tag">{{fact.tag}}小知识</text>
        <text class="fact-count">{{factIndex}}/{{factTotal}}</text>
      </view>
      <view class="fact-title">{{fact.title}}</view>
      <view class="fact-text">{{fact.text}}</view>
      <view class="fact-line">
        <text class="fact-label">知</text>
        <text class="fact-line-text">{{fact.fact}}</text>
      </view>
      <view class="fact-source">出处：{{fact.source}}</view>
      <view class="fact-hint">{{factHint}}</view>
      <view class="fact-btn" bindtap="closeFact">继 续 答 题</view>
    </view>
  </view>
</view>
