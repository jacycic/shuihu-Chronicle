/* 场景容器 */
.scene{
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 60rpx 40rpx;
  align-items: center;
}
/* 场景按钮 */
.scene-item{
  width: 480rpx;
  display:flex;
  justify-content:space-between;
  align-items:center;
  box-sizing:border-box;
  padding:24rpx 40rpx;
  text-align: center;
  font-family: "KaiTi","STKaiti",system-ui, -apple-system, sans-serif;
  font-size: 34rpx;
  color:#553a24;
  background-color: #fffbf5;
  border: 2rpx solid #c9b89f;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 8rpx rgba(85,58,36,0.12);
  -webkit-font-smoothing: antialiased;
}
.scene-item:active{
  background-color: #f3e9d8;
  transform: scale(0.97);
}
/* 右侧箭头 */
.arrow{
  font-size:32rpx;
  color:#8c5c38;
}
/* 未解锁禁用样式 */
.scene-item-disabled{
  background:#ece8e2;
  color:#aaa;
  border-color:#ddd;
  box-shadow:none;
}
.scene-item-disabled:active{
  transform:none;
  background:#ece8e2;
}

/* 弹窗遮罩 */
.dialog-mask{
  position: fixed;
  top:0;
  left:0;
  width:100vw;
  height:100vh;
  background:rgba(0,0,0,0.6);
  z-index:999;
  display:flex;
  align-items:center;
  justify-content:center;
}
.dialog-box{
  width: 680rpx;
  max-height: 90vh;
  background:#fffbf5;
  border:2rpx solid #c9b89f;
  border-radius:24rpx;
  padding:30rpx;
  box-sizing:border-box;
  font-family: "KaiTi","STKaiti",system-ui, -apple-system, sans-serif;
  display:flex;
  flex-direction:column;
  gap:20rpx;
  overflow:hidden;
  -webkit-font-smoothing: antialiased;
}

/* 两个内容区通用 */
.dialog-section{
  background:#fff;
  border:2rpx solid #d9ccb4;
  border-radius:16rpx;
  padding:20rpx;
  box-sizing:border-box;
}

/* 介绍区 */
.dialog-intro{
  flex: 0 0 auto;
}

.section-title{
  font-size:26rpx;
  color:#8c6b45;
  margin-bottom:10rpx;
  -webkit-font-smoothing: antialiased;
}

.scene-name{
  font-size:34rpx;
  font-weight:bold;
  color:#553a24;
  margin-bottom:8rpx;
  -webkit-font-smoothing: antialiased;
}

.scene-desc{
  font-size:28rpx;
  color:#443322;
  line-height:1.6;
  -webkit-font-smoothing: antialiased;
}

/* 聊天区 */
.dialog-chat{
  flex: 1;
  display:flex;
  flex-direction:column;
  overflow:hidden;
  -webkit-font-smoothing: antialiased;
}

.chat-list{
  height: 60vh;
  background:#faf6ee;
  border-radius:12rpx;
  padding:20rpx;
  box-sizing:border-box;
  -webkit-font-smoothing: antialiased;
}

.chat-item{
  display:flex;
  margin-bottom:20rpx;
  width:100%;
}

/* ===== 消息行布局【调换左右：user左，npc右】 ===== */
.msg-row{
  display:flex;
  gap:16rpx;
  align-items:flex-start;
  width:100%;
}
/* NPC 右边 */
.bot-row{
  justify-content:flex-end;
}
/* 用户消息 左边 */
.user-row{
  justify-content:flex-start;
}

/* 头像盒子 默认白色方形 */
.avatar-box{
  width:72rpx;
  height:72rpx;
  border-radius:8rpx;
  border:1rpx solid #ccc;
  flex-shrink:0;
}
.msg-content{
  display:flex;
  flex-direction:column;
  max-width: calc(75% - 80rpx);
}
.msg-name{
  font-size:24rpx;
  color:#666;
  margin-bottom:6rpx;
  -webkit-font-smoothing: antialiased;
}
/* NPC名字靠右 */
.user-name{
  text-align:right;
}
/* 旁白样式，居中 */
.narration-text{
  width:100%;
  text-align:center;
  font-size:26rpx;
  color:#776448;
  padding:12rpx 0;
  -webkit-font-smoothing: antialiased;
}
.chat-bubble{
  max-width:75%;
  padding:16rpx 24rpx;
  border-radius:20rpx;
  font-size:28rpx;
  line-height:1.5;
  -webkit-font-smoothing: antialiased;
}
/* 用户（左侧）气泡：白底棕边框 */
.chat-item.user .chat-bubble{
  background:#d77253;
  color:#ffffff;
  
}
/* NPC好汉（右侧）气泡：红棕色背景白字 */
.chat-item.bot .chat-bubble{
  background:#fff;
  
  border:2rpx solid #d9ccb4;
  color:#443322;
}

/* 底部关闭按钮 */
.dialog-close{
  width:100%;
  text-align:center;
  background:#b85c3e;
  color:#fff;
  padding:24rpx 0;
  border-radius:99rpx;
  font-size:30rpx;
}
.dialog-close:active{
  opacity:0.8;
}

/* 美化滚动条 */
.chat-list::-webkit-scrollbar {
  width: 6rpx;
}
.chat-list::-webkit-scrollbar-thumb {
  background: #c9b89f;
  border-radius: 6rpx;
}
.chat-list::-webkit-scrollbar-track {
  background: transparent;
}

.avatar-box image{
  width:100%;
  height:100%;
  border-radius:8rpx;
}