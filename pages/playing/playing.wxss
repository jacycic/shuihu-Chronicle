page {
  background-image: url("https://shuihu2026.oss-cn-guangzhou.aliyuncs.com/img/other/background1.png");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  font-family: "KaiTi","STKaiti",system-ui, -apple-system, sans-serif;
}

.page-wrap{
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  position: relative;
}

/* 四角古风角花 */
.page-wrap::after,
.page-wrap .corner-decoration{
  content:"";
  position:absolute;
  width:70rpx;
  height:70rpx;
  border-color:rgba(120,90,50,0.35);
  border-style:solid;
  pointer-events:none;
}

.page-wrap::after{
  top:50rpx;
  right:50rpx;
  border-width:4rpx 4rpx 0 0;
}

.corner-tl{
  top:50rpx;
  left:50rpx;
  border-width:4rpx 0 0 4rpx;
}

.corner-bl{
  bottom:calc(140rpx + env(safe-area-inset-bottom) + 60rpx);
  left:50rpx;
  border-width:0 0 4rpx 4rpx;
}

.corner-br{
  bottom:calc(140rpx + env(safe-area-inset-bottom) + 60rpx);
  right:50rpx;
  border-width:0 4rpx 4rpx 0;
}

/* 顶部标题区微调 */
.title-bar{
  position:relative;
  z-index:2;
  padding:40rpx 50rpx 20rpx;
}

.title-text{
  font-size:32rpx;
  color:#6b4a22;
  letter-spacing:4rpx;
}

.title-underline{
  width:120rpx;
  height:4rpx;
  background:linear-gradient(90deg,#c9a96e,transparent);
  margin-top:10rpx;
}

/* 场景容器 */
.scene{
  position:relative;
  z-index:2;
  display: flex;
  flex-direction: column;
  gap: 36rpx;
  padding: 40rpx 40rpx 60rpx;
  align-items: center;
}

/* 场景按钮：和背景更统一 */
.scene-item{
  width: 520rpx;
  display:flex;
  justify-content:space-between;
  align-items:center;
  box-sizing:border-box;
  padding:28rpx 40rpx;
  text-align: center;
  font-size: 34rpx;
  color:#5b4020;
  background-color: #fbf6e7;
  border: 2rpx solid #d7c49a;
  border-radius: 20rpx;
  box-shadow:
    0 6rpx 14rpx rgba(120,90,40,0.12),
    inset 0 0 0 1rpx rgba(255,255,255,0.6);
  -webkit-font-smoothing: antialiased;
  transition: all 0.18s ease;
}

.scene-item:active{
  background-color: #f5e9cb;
  transform: scale(0.97);
  box-shadow:0 3rpx 8rpx rgba(120,90,40,0.15);
}

.arrow{
  font-size:32rpx;
  color:#a57940;
}

.scene-item-disabled{
  background:#ece4d2;
  color:#b4a587;
  border-color:#d8cdb2;
  box-shadow:none;
}

.scene-item-disabled:active{
  transform:none;
  background:#ece4d2;
}

/* 弹窗遮罩 */
.dialog-mask{
  position: fixed;
  top:0;
  left:0;
  width:100vw;
  height:100vh;
  background:rgba(40,30,20,0.65);
  z-index:999;
  display:flex;
  align-items:center;
  justify-content:center;
  box-sizing: border-box;
  padding: calc(40rpx + env(safe-area-inset-top)) 30rpx calc(40rpx + env(safe-area-inset-bottom));
}

.dialog-box{
  width: 680rpx;
  max-height: 100%;
  background:#fbf6e7;
  border:2rpx solid #d7c49a;
  border-radius:28rpx;
  padding:30rpx;
  box-sizing:border-box;
  font-family: "KaiTi","STKaiti",system-ui, -apple-system, sans-serif;
  display:flex;
  flex-direction:column;
  gap:20rpx;
  overflow:hidden;
  -webkit-font-smoothing: antialiased;
  box-shadow:0 10rpx 30rpx rgba(0,0,0,0.3);
}

/* 两个内容区通用 */
.dialog-section{
  background:#fffaf0;
  border:2rpx solid #e2d4b0;
  border-radius:18rpx;
  padding:22rpx;
  box-sizing:border-box;
}

.dialog-intro{
  flex: 0 0 auto;
}

.section-title{
  font-size:26rpx;
  color:#8c6b45;
  margin-bottom:10rpx;
  -webkit-font-smoothing: antialiased;
}

.scene-name{
  font-size:34rpx;
  font-weight:bold;
  color:#5b4020;
  margin-bottom:8rpx;
  -webkit-font-smoothing: antialiased;
}

.scene-desc{
  font-size:28rpx;
  color:#4a3520;
  line-height:1.6;
  -webkit-font-smoothing: antialiased;
}

/* 聊天区 */
.dialog-chat{
  flex: 1;
  display:flex;
  flex-direction:column;
  overflow:hidden;
  -webkit-font-smoothing: antialiased;
}

/* =========重点改这里：恢复固定高度，scroll-y才能生效 =========*/
.chat-list{
  height: 54vh;
  background:#f7efdc;
  border-radius:14rpx;
  padding:20rpx;
  box-sizing:border-box;
  -webkit-font-smoothing: antialiased;
}

.chat-item{
  display:flex;
  margin-bottom:22rpx;
  width:100%;
}

.msg-row{
  display:flex;
  gap:16rpx;
  align-items:flex-start;
  width:100%;
}

.bot-row{
  justify-content:flex-end;
}

.user-row{
  justify-content:flex-start;
}

.avatar-box{
  width:72rpx;
  height:72rpx;
  border-radius:10rpx;
  border:1rpx solid #d9c9a3;
  flex-shrink:0;
  overflow:hidden;
  background:#fff;
}

.msg-content{
  display:flex;
  flex-direction:column;
  max-width: calc(75% - 80rpx);
}

.msg-name{
  font-size:24rpx;
  color:#7a5a30;
  margin-bottom:6rpx;
  -webkit-font-smoothing: antialiased;
}

.user-name{
  text-align:right;
}

.narration-text{
  width:100%;
  text-align:center;
  font-size:26rpx;
  color:#8a6a40;
  padding:12rpx 0;
  -webkit-font-smoothing: antialiased;
}

.chat-bubble{
  max-width:75%;
  padding:16rpx 24rpx;
  border-radius:22rpx;
  font-size:28rpx;
  line-height:1.6;
  word-break:break-all;
  -webkit-font-smoothing: antialiased;
}

.chat-item.user .chat-bubble{
  background:#c75a3a;
  color:#ffffff;
}

.chat-item.bot .chat-bubble{
  background:#fff;
  border:2rpx solid #e2d4b0;
  color:#4a3520;
}

.dialog-close{
  width:100%;
  text-align:center;
  background:#b85c3e;
  color:#fff;
  padding:24rpx 0;
  border-radius:99rpx;
  font-size:30rpx;
  transition:opacity 0.15s;
}

.dialog-close:active{
  opacity:0.8;
}

.chat-list::-webkit-scrollbar {
  width: 6rpx;
}

.chat-list::-webkit-scrollbar-thumb {
  background: #c9b89f;
  border-radius: 6rpx;
}

.chat-list::-webkit-scrollbar-track {
  background: transparent;
}

.avatar-box image{
  width:100%;
  height:100%;
  border-radius:10rpx;
}

/* 底部 Tab */
.bottom-tab-wrap {
  position: fixed;
  left: 0rpx;
  right: 0rpx;
  bottom: 0rpx;
  height:120rpx;
  display:flex;
  border-top-left-radius:40rpx;
  border-top-right-radius:40rpx;
  overflow:hidden;
  background-image: linear-gradient(90deg,#64C2CC,#1DACDB);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  z-index:99;

  box-shadow:
    0 -4rpx 16rpx rgba(30,140,170,0.25),
    inset 0 2rpx 0 rgba(255,255,255,0.25);
}

.bottom-tab-item {
  flex: 1;
  height:100%;
  display:flex;
  justify-content:center;
  align-items:center;
  font-size: 36rpx;
  color:#ffffff;
  border-right: 2rpx solid rgba(255,255,255,0.35);
}

.bottom-tab-item:last-child{
  border-right:none;
}

.bottom-tab-item:active{
  background:rgba(255,255,255,0.18);
}

/* 北宋示意舆图 */
.map-card{
  position:relative;
  z-index:2;
  margin:30rpx 30rpx 0;
  padding:24rpx 24rpx 20rpx;
  border-radius:24rpx;
  border:2rpx solid rgba(184,134,11,0.28);
  background:rgba(255,252,242,0.92);
  box-shadow:0 8rpx 24rpx rgba(120,90,40,0.14);
}
.map-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16rpx;
}
.map-head-left{ min-width:0; }
.map-title{
  font-size:30rpx;
  font-weight:bold;
  letter-spacing:5rpx;
  color:#6b4a22;
}
.map-sub{
  font-size:21rpx;
  color:#8a7658;
  text-align:left;
}
.map-zoom-entry{
  flex-shrink:0;
  padding:10rpx 24rpx;
  border-radius:999rpx;
  border:1rpx solid rgba(168,50,42,0.35);
  background:#f6eed9;
  color:#8f2c22;
  font-size:22rpx;
  letter-spacing:2rpx;
}
.map-zoom-entry-hover{ background:#eadbba; }
.map-canvas{
  position:relative;
  height:420rpx;
  margin-top:18rpx;
  border-radius:16rpx;
  border:1rpx dashed rgba(120,90,50,0.3);
  background:
    linear-gradient(rgba(160,140,100,0.07) 1rpx,transparent 1rpx),
    linear-gradient(90deg,rgba(160,140,100,0.07) 1rpx,transparent 1rpx),
    linear-gradient(160deg,#f3ecd8,#e8e0c8);
  background-size:56rpx 56rpx,56rpx 56rpx,100% 100%;
  overflow:hidden;
}
.map-river{
  position:absolute;
  height:130rpx;
  border-top:3rpx dashed rgba(84,132,164,0.45);
  border-radius:50%;
  pointer-events:none;
}
.map-river-huang{ width:88%; left:6%; top:28%; transform:rotate(-6deg); }
.map-river-chang{ width:94%; left:3%; top:60%; transform:rotate(5deg); }
.map-compass{
  position:absolute;
  top:12rpx;
  left:16rpx;
  font-size:20rpx;
  color:#9a8258;
}
.map-river-note{
  position:absolute;
  left:14rpx;
  top:31%;
  font-size:18rpx;
  color:rgba(84,132,164,0.8);
}
.map-river-note-south{ top:65%; }
.map-point{
  position:absolute;
  transform:translate(-50%,-50%);
  display:flex;
  flex-direction:column;
  align-items:center;
  z-index:2;
}
.map-dot{
  width:12rpx;
  height:12rpx;
  border-radius:50%;
  background:#a9b9a0;
  border:2rpx solid #fffdf7;
  box-shadow:0 0 0 2rpx rgba(120,90,50,0.3);
}
.map-point.visited .map-dot{ background:#c9a96e; }
.map-point.active .map-dot{
  width:22rpx;
  height:22rpx;
  background:#b8432c;
  box-shadow:0 0 0 6rpx rgba(184,67,44,0.18);
  animation:mapPulse 1.8s ease-in-out infinite;
}
.map-name{
  margin-top:6rpx;
  font-size:18rpx;
  color:#6b5738;
  white-space:nowrap;
}
.map-point.active .map-name{
  color:#a8322a;
  font-weight:bold;
  font-size:20rpx;
}
@keyframes mapPulse{
  0%,100%{ box-shadow:0 0 0 6rpx rgba(184,67,44,0.18); }
  50%{ box-shadow:0 0 0 12rpx rgba(184,67,44,0.06); }
}
.map-foot{
  margin-top:16rpx;
  font-size:22rpx;
  line-height:1.6;
  color:#6b5738;
}
.map-foot-mark{ color:#a8322a; margin-right:8rpx; }
.map-disclaimer{
  margin-top:8rpx;
  text-align:right;
  font-size:19rpx;
  color:#a89a7e;
}

/* 舆图放大层 */
.map-zoom-mask{
  position:fixed;
  left:0; top:0; right:0; bottom:0;
  z-index:1200;
  background:rgba(28,22,16,0.72);
  display:flex;
  align-items:center;
  justify-content:center;
  padding:24rpx;
}
.map-zoom-panel{
  width:100%;
  max-width:710rpx;
  border-radius:24rpx;
  border:2rpx solid rgba(217,185,108,0.5);
  background:#fffdf5;
  box-shadow:0 20rpx 60rpx rgba(0,0,0,0.45);
  overflow:hidden;
}
.map-zoom-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16rpx;
  padding:22rpx 24rpx;
  border-bottom:1rpx solid rgba(184,134,11,0.25);
}
.map-zoom-head-left{ min-width:0; }
.map-zoom-title{
  font-size:30rpx;
  font-weight:bold;
  letter-spacing:4rpx;
  color:#6b4a22;
}
.map-zoom-sub{
  margin-top:6rpx;
  font-size:21rpx;
  color:#8a7658;
}
.map-zoom-close{
  flex-shrink:0;
  width:56rpx; height:56rpx; line-height:52rpx;
  text-align:center;
  border-radius:50%;
  border:1rpx solid rgba(168,50,42,0.3);
  color:#8f2c22;
  font-size:36rpx;
}
.map-zoom-scroll{
  width:100%;
  height:66vh;
  background:#e8e0c8;
}
.map-zoom-canvas{
  position:relative;
  background:
    linear-gradient(rgba(160,140,100,0.07) 1rpx,transparent 1rpx),
    linear-gradient(90deg,rgba(160,140,100,0.07) 1rpx,transparent 1rpx),
    linear-gradient(160deg,#f3ecd8,#e8e0c8);
  background-size:56rpx 56rpx,56rpx 56rpx,100% 100%;
}
.map-zoom-canvas .map-river{ height:200rpx; }
.map-zoom-canvas .map-dot{ width:18rpx; height:18rpx; }
.map-zoom-canvas .map-point.active .map-dot{ width:30rpx; height:30rpx; }
.map-zoom-canvas .map-name{
  margin-top:8rpx;
  padding:2rpx 8rpx;
  border-radius:6rpx;
  background:rgba(255,253,245,0.82);
  font-size:20rpx;
}
.map-zoom-canvas .map-point.active .map-name{ font-size:23rpx; }
.map-zoom-tip{
  padding:14rpx 24rpx 0;
  font-size:20rpx;
  color:#a08d6c;
  text-align:center;
}
.map-zoom-tools{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:20rpx;
  padding:18rpx 24rpx 24rpx;
}
.map-zoom-btn{
  width:72rpx; height:72rpx; line-height:68rpx;
  text-align:center;
  border-radius:50%;
  border:1rpx solid rgba(184,134,11,0.45);
  background:#f3ecdb;
  color:#6b4a22;
  font-size:36rpx;
}
.map-zoom-level{
  width:110rpx;
  text-align:center;
  font-size:26rpx;
  color:#6b4a22;
}
.map-zoom-done{
  margin-left:12rpx;
  padding:14rpx 30rpx;
  border-radius:999rpx;
  background:#8f2c22;
  color:#fff5e0;
  font-size:24rpx;
  letter-spacing:2rpx;
}

/* 地名小窗 */
.map-point-hover{ opacity:0.65; }
.place-mask{
  position:fixed;
  left:0; top:0; right:0; bottom:0;
  z-index:1400;
  background:rgba(28,22,16,0.62);
  display:flex;
  align-items:center;
  justify-content:center;
  padding:36rpx;
}
.place-pop{
  width:100%;
  max-width:620rpx;
  max-height:78vh;
  overflow-y:auto;
  padding:30rpx 30rpx 26rpx;
  border-radius:24rpx;
  border:2rpx solid rgba(184,134,11,0.45);
  background:linear-gradient(165deg,#fffdf5,#f7f1e2);
  box-shadow:0 20rpx 60rpx rgba(0,0,0,0.42);
}
.place-pop-head{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:16rpx;
  padding-bottom:20rpx;
  border-bottom:1rpx solid rgba(184,134,11,0.3);
}
.place-pop-title{
  font-size:40rpx;
  font-weight:bold;
  letter-spacing:4rpx;
  color:#3b2f22;
}
.place-pop-type{
  display:inline-block;
  margin-top:8rpx;
  padding:4rpx 14rpx;
  border-radius:999rpx;
  background:#f0e3c4;
  color:#8a6a34;
  font-size:21rpx;
  letter-spacing:2rpx;
}
.place-pop-close{
  flex-shrink:0;
  width:56rpx; height:56rpx; line-height:52rpx;
  text-align:center;
  border-radius:50%;
  border:1rpx solid rgba(168,50,42,0.3);
  color:#8f2c22;
  font-size:36rpx;
}
.place-row{
  display:flex;
  align-items:flex-start;
  gap:18rpx;
  margin-top:22rpx;
}
.place-label{
  flex-shrink:0;
  width:130rpx;
  padding-top:4rpx;
  font-size:21rpx;
  letter-spacing:2rpx;
  color:#9a8258;
}
.place-value{
  flex:1;
  min-width:0;
  font-size:26rpx;
  line-height:1.75;
  color:#5a4a33;
}
.place-value.strong{
  font-size:29rpx;
  font-weight:bold;
  color:#8f2c22;
}
.place-note{
  margin-top:22rpx;
  padding:16rpx 20rpx;
  border-radius:14rpx;
  background:#f3ecdb;
  font-size:22rpx;
  line-height:1.7;
  color:#8a7658;
}
.place-status{
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  gap:14rpx;
  margin-top:24rpx;
  padding-top:20rpx;
  border-top:1rpx dashed rgba(184,134,11,0.35);
}
.place-tag{
  padding:6rpx 18rpx;
  border-radius:999rpx;
  background:#e6ddc6;
  color:#8a7658;
  font-size:21rpx;
}
.place-tag.visited{ background:#f0dfba; color:#8a6a34; }
.place-tag.current{ background:#a8322a; color:#fff5e0; }
.place-scene{ font-size:21rpx; color:#8a7658; }
.place-disclaimer{
  margin-top:18rpx;
  text-align:right;
  font-size:19rpx;
  color:#b3a487;
}