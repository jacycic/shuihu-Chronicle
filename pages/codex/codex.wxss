.container {
  padding: 30rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
}

.card-item {
  border: 2rpx solid #1DACDB;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  background: #fff;

  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

/* 左侧文字区域 */
.hero-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

/* 右侧图片盒子 */
.hero-img-box {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
  flex-shrink: 0;
}

.hero-img {
  width: 100%;
  height: 100%;
}
.empty-placeholder{
  width:100%;
  height:100%;
  background:#8d97a1;
  border-radius:12rpx;
}

.name {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
}

.nick {
  display: block;
  font-size: 26rpx;
  color: #555;
  margin-top: 6rpx;
}

.star {
  display: block;
  font-size: 26rpx;
  color: #1DACDB;
  margin-top: 6rpx;
  margin-bottom: 14rpx;
}

.attr {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  font-size: 24rpx;
  color: #666;
}