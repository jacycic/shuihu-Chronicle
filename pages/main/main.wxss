.action{
  border-radius: 12rpx;
  background-image: linear-gradient(90deg,#64C2CC,#1DACDB);
}

.button-ctrl{
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

/*底部大容器*/
.bottom-box{
  position:absolute;
  left:0rpx;
  right:0rpx;
  bottom:0rpx;
  height:120rpx;
  display:flex;
  /*只给大盒子 左上、右上圆角*/
  border-top-left-radius:12rpx;
  border-top-right-radius:12rpx;
  overflow:hidden; /*重点！裁剪内部子元素，保证圆角生效*/
  background-image: linear-gradient(90deg,#64C2CC,#1DACDB);
}

/*三个子项，平分宽度*/
.bottom-item{
  flex:1; /*自动三等分宽度*/
  height:100%;
  display:flex;
  justify-content:center;
  align-items:center;
  /* background-image: linear-gradient(90deg,#64C2CC,#1DACDB); */
  border-right:2rpx solid #b0c0d1; /*黑色垂直分割线*/
}

/*最后一个去掉右边分割线*/
.last-item{
  border-right:none;
}

.circle{
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid #fff;

  /* 四周柔和散色阴影 */
  box-shadow:
  0 0 12rpx 4rpx rgba(255, 160, 50, 0.45),
  0 0 24rpx 8rpx rgba(255, 100, 30, 0.35),
  0 0 36rpx 14rpx rgba(255, 50, 20, 0.25);

  margin: 0 auto 20rpx auto;
  position: relative;
}

.hero-circle{
  width: 550rpx;
  height: 550rpx;
  transform: translate(-160rpx,-30rpx);
  
}

