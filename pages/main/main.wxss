page{
  background-image: url("https://shuihu2026.oss-cn-guangzhou.aliyuncs.com/img/other/background1.png");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  background-attachment: fixed;
}
.action{
  border-radius: 12rpx;
  background-image: linear-gradient(90deg,#64C2CC,#1DACDB);
  border: 2rpx solid gray;
}

.button-ctrl{
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

/*底部大容器*/
.bottom-box{
  position:absolute;
  left:0rpx;
  right:0rpx;
  bottom:0rpx;
  height:120rpx;
  display:flex;
  border-top: 2rpx solid gray;
  /*只给大盒子 左上、右上圆角*/
  border-top-left-radius:12rpx;
  border-top-right-radius:12rpx;
  overflow:hidden; /*重点！裁剪内部子元素，保证圆角生效*/
  background-image: linear-gradient(90deg,#64C2CC,#1DACDB);
}

/*三个子项，平分宽度*/
.bottom-item{
  flex:1; /*自动三等分宽度*/
  height:100%;
  display:flex;
  justify-content:center;
  align-items:center;
  /* background-image: linear-gradient(90deg,#64C2CC,#1DACDB); */
  border-right:2rpx solid #b0c0d1; /*黑色垂直分割线*/
}

/*最后一个去掉右边分割线*/
.last-item{
  border-right:none;
}

.circle{
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid #fff;

  /* 四周柔和散色阴影 */
  box-shadow:
  0 0 12rpx 4rpx rgba(255, 160, 50, 0.45),
  0 0 24rpx 8rpx rgba(255, 100, 30, 0.35),
  0 0 36rpx 14rpx rgba(255, 50, 20, 0.25);

  margin: 0 auto 20rpx auto;
  position: relative;
}

.hero-circle{
  width: 550rpx;
  height: 550rpx;
  transform: translate(-160rpx,-30rpx);
  
}

.unlock-tip{
  position: fixed;
  top: 40rpx;
  right:30rpx;
  z-index:9999;
  padding:20rpx 30rpx;
  background:rgba(169, 157, 45, 0.65);
  color:#fff;
  border-radius:12rpx;
  font-size:28rpx;
  animation: fadeIn 0.3s ease;
  width: 200rpx;
  height: 100rpx;
  border: 2px solid rgba(255, 215, 0, 0.8);
  background: linear-gradient(135deg, #620404 0%, #c41e09 40%, #ff5722 75%, #ffb040 100%);
  box-shadow: 0 10px 30px rgba(220,30,10,0.45);
}
.unlock-text{
  color: rgb(222, 244, 52);
}
@keyframes fadeIn{
  from{opacity:0; transform:translateY(-20rpx)}
  to{opacity:1; transform:translateY(0)}
}

/*成就解锁提示，黄色渐变主题，和unlock-tip布局一致*/
/*成就解锁提示，黄色渐变，位置下移，不和好汉弹窗重叠*/
.achievement-tip{
  position: fixed;
  top: 160rpx; /* 原来40rpx，改成160rpx，放在好汉弹窗下面 */
  right:30rpx;
  z-index:9999;
  padding:20rpx 30rpx;
  border-radius:12rpx;
  font-size:28rpx;
  animation: fadeIn 0.3s ease;
  width: 200rpx;
  height: 100rpx;
  border: 2rpx solid rgba(255, 215, 0, 0.9);
  background: linear-gradient(135deg, #b8860b 0%, #daa520 40%, #ffd700 75%, #fff380 100%);
  box-shadow: 0 10rpx 30rpx rgba(218,165,32,0.45);
}
.achievement-text{
  color: #6b2814;
  font-weight:bold;
}