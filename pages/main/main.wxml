
<!--pages/main/main.wxml-->
<!-- 右上角解锁提示 -->
<view wx:if="{{showUnlockTip}}" class="unlock-tip">
  <text class="unlock-text">✅ 解锁好汉图鉴：{{unlockHeroName}}</text>
</view>
<view wx:if="{{showAchievementTip}}" class="achievement-tip">
  <text class="achievement-text">🏆解锁成就：{{unlockAchievementName}}</text>
</view>
<view class="button-ctrl">
  <view class="circle">
    <image class="hero-circle" src="{{heroImg}}" mode="aspectFill"/>
  </view>
  <text>{{role}}</text>
  <view bind:tap="ClicknSound">
    <button class="action" bind:tap="goPlaying">开始</button>
  </view>

  <view class="bottom-box" bind:tap="ClicknSound">
    <view class="bottom-item" bind:tap="goMans">好汉</view>
    <view class="bottom-item" bind:tap="goAchievements">成就</view>
    <view class="bottom-item" bind:tap="goCodex">图鉴</view>
  </view>
</view>


