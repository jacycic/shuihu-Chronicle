page {
  background-color: #f7f2e6;
  background-image:
    linear-gradient(rgba(247, 242, 230, 0.88), rgba(247, 242, 230, 0.88)),
    url("https://shuihu2026.oss-cn-guangzhou.aliyuncs.com/img/other/background1.png");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.page {
  min-height: 100vh;
  padding: 36rpx 28rpx 80rpx;
  box-sizing: border-box;
}

.page-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.header-title {
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 52rpx;
  font-weight: bold;
  letter-spacing: 10rpx;
  color: #3b2f22;
}

.header-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #9a8258;
}

.header-ornament {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 18rpx;
}

.ornament-line {
  width: 110rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(184, 134, 11, 0), rgba(184, 134, 11, 0.75));
}

.ornament-line.reverse { transform: rotate(180deg); }

.ornament-dot {
  width: 10rpx;
  height: 10rpx;
  background: #b8860b;
  transform: rotate(45deg);
}

.card {
  margin-bottom: 26rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(184, 134, 11, 0.22);
  background: #fffdf7;
  box-shadow: 0 10rpx 30rpx rgba(90, 70, 40, 0.1);
}

.card-hover { opacity: 0.88; }
.btn-hover { opacity: 0.85; }

/* 部署引导 */
.guide-card { text-align: center; padding: 44rpx 32rpx; }

.guide-mark {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 22rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(184, 134, 11, 0.5);
  color: #a8322a;
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 44rpx;
  line-height: 96rpx;
}

.guide-title {
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 36rpx;
  font-weight: bold;
  color: #3b2f22;
}

.guide-error {
  margin: 14rpx 0 0;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #fbe9e4;
  color: #a8322a;
  font-size: 23rpx;
  line-height: 1.6;
}

.guide-desc {
  margin: 18rpx 0 10rpx;
  font-size: 24rpx;
  color: #8a7658;
  text-align: left;
}

.guide-step {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 13rpx 0;
  border-top: 1rpx dashed rgba(184, 134, 11, 0.25);
  font-size: 23rpx;
  line-height: 1.5;
  color: #6b5738;
  text-align: left;
}

.step-no {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #a8322a;
  color: #fff5e0;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
}

.retry-btn {
  margin-top: 26rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: #3b2f22;
  color: #f7ecd2;
  font-size: 27rpx;
  letter-spacing: 4rpx;
}

/* 题库总览 */
.bank-card { background: linear-gradient(165deg, #fffdf7, #fbf1d8); }

.bank-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bank-label {
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: #9a8258;
}

.bank-tags {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #3b2f22;
}

.bank-num {
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 60rpx;
  font-weight: bold;
  color: #a8322a;
}

.bank-unit { font-size: 24rpx; color: #9a8258; }

.identity-text {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed rgba(184, 134, 11, 0.3);
  font-size: 22rpx;
  color: #8a7658;
}

/* 模式选择 */
.mode-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.mode-mark {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #8f2c22, #b8860b);
  color: #fff6e2;
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.friend-mark { background: linear-gradient(135deg, #3b2f22, #7a6a4f); }

.mode-info { flex: 1; min-width: 0; }

.mode-title {
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 34rpx;
  font-weight: bold;
  letter-spacing: 3rpx;
  color: #3b2f22;
}

.mode-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8a7658;
}

.mode-arrow { font-size: 40rpx; color: #b8860b; }

/* 好友面板 */
.panel-label {
  font-size: 23rpx;
  letter-spacing: 3rpx;
  color: #9a8258;
  margin-bottom: 16rpx;
}

.create-btn {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #8f2c22, #b8860b);
  color: #fff6e2;
  font-size: 27rpx;
  letter-spacing: 3rpx;
}

.panel-split {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 26rpx 0;
  color: #b3a487;
  font-size: 22rpx;
}

.panel-split::before,
.panel-split::after {
  content: "";
  flex: 1;
  height: 1rpx;
  background: rgba(184, 134, 11, 0.25);
}

.room-row { display: flex; gap: 14rpx; }

.room-input {
  flex: 1;
  height: 80rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  border: 1rpx solid rgba(184, 134, 11, 0.35);
  background: #fbf6e9;
  font-size: 30rpx;
  letter-spacing: 6rpx;
  color: #3b2f22;
}

.input-placeholder { color: #b3a487; letter-spacing: 2rpx; font-size: 25rpx; }

.join-btn {
  width: 150rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #3b2f22;
  color: #f7ecd2;
  font-size: 27rpx;
  letter-spacing: 2rpx;
}

.error-bar {
  margin-bottom: 24rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #fbe9e4;
  color: #a8322a;
  font-size: 24rpx;
  text-align: center;
}

/* 规则 */
.rule-card {
  padding: 26rpx 30rpx;
  border-radius: 24rpx;
  background: rgba(255, 253, 247, 0.7);
  border: 1rpx dashed rgba(184, 134, 11, 0.3);
}

.rule-title {
  margin-bottom: 14rpx;
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 28rpx;
  letter-spacing: 3rpx;
  color: #3b2f22;
}

.rule-line {
  font-size: 22rpx;
  line-height: 1.8;
  color: #8a7658;
}
