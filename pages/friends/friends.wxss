page {
  background-color: #f7f2e6;
  background-image:
    linear-gradient(rgba(247, 242, 230, 0.88), rgba(247, 242, 230, 0.88)),
    url("https://shuihu2026.oss-cn-guangzhou.aliyuncs.com/img/other/background1.png");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.page {
  min-height: 100vh;
  padding: 36rpx 28rpx 80rpx;
  box-sizing: border-box;
}

.page-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.header-title {
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 52rpx;
  font-weight: bold;
  letter-spacing: 10rpx;
  color: #3b2f22;
}

.header-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #9a8258;
}

.header-ornament {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 18rpx;
}

.ornament-line {
  width: 110rpx;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(184, 134, 11, 0), rgba(184, 134, 11, 0.75));
}

.ornament-line.reverse {
  transform: rotate(180deg);
}

.ornament-dot {
  width: 10rpx;
  height: 10rpx;
  background: #b8860b;
  transform: rotate(45deg);
}

.card {
  margin-bottom: 28rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(184, 134, 11, 0.22);
  background: #fffdf7;
  box-shadow: 0 10rpx 30rpx rgba(90, 70, 40, 0.1);
}

.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 20rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(184, 134, 11, 0.18);
}

.card-title {
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 34rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  color: #3b2f22;
}

.card-sub {
  font-size: 24rpx;
  color: #9a8258;
}

.btn-hover {
  opacity: 0.85;
}

/* 未开通引导 */
.guide-card {
  text-align: center;
  padding: 48rpx 32rpx;
}

.guide-mark {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(184, 134, 11, 0.5);
  color: #a8322a;
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 46rpx;
  line-height: 96rpx;
}

.guide-title {
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 38rpx;
  font-weight: bold;
  color: #3b2f22;
}

.guide-desc {
  margin: 16rpx 0 30rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #8a7658;
  text-align: left;
}

.guide-step {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-top: 1rpx dashed rgba(184, 134, 11, 0.25);
  font-size: 24rpx;
  line-height: 1.5;
  color: #6b5738;
  text-align: left;
}

.step-no {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #a8322a;
  color: #fff5e0;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
}

/* 邀请码 */
.code-card {
  text-align: center;
  background: linear-gradient(165deg, #fffdf7, #fbf1d8);
}

.card-label {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #9a8258;
}

.code-value {
  margin: 16rpx 0 10rpx;
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 76rpx;
  font-weight: bold;
  letter-spacing: 14rpx;
  color: #a8322a;
}

.code-hint {
  font-size: 23rpx;
  line-height: 1.6;
  color: #8a7658;
}

.copy-btn {
  margin-top: 26rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #8f2c22, #b8860b);
  color: #fff6e2;
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

.error-bar {
  margin-bottom: 24rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #fbe9e4;
  color: #a8322a;
  font-size: 25rpx;
  text-align: center;
}

/* 查找与结果 */
.input-row {
  display: flex;
  gap: 14rpx;
}

.code-input {
  flex: 1;
  height: 76rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(184, 134, 11, 0.35);
  background: #fbf6e9;
  font-size: 30rpx;
  letter-spacing: 6rpx;
  color: #3b2f22;
}

.input-placeholder {
  color: #b3a487;
  letter-spacing: 2rpx;
  font-size: 26rpx;
}

.search-btn {
  width: 150rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #3b2f22;
  color: #f7ecd2;
  font-size: 27rpx;
  letter-spacing: 2rpx;
}

.result-card,
.friend-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.result-card {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed rgba(184, 134, 11, 0.3);
}

.avatar-circle {
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(135deg, #8f2c22, #b8860b);
  color: #fff6e2;
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-circle.small {
  width: 72rpx;
  height: 72rpx;
  font-size: 32rpx;
}

.avatar-circle image {
  width: 100%;
  height: 100%;
}

.result-info,
.friend-info {
  flex: 1;
  min-width: 0;
}

.result-name,
.friend-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #3b2f22;
}

.result-sub,
.friend-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9a8258;
}

.state-tag,
.add-btn,
.reject-btn,
.accept-btn,
.remove-btn {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.state-tag {
  background: #f0e8d6;
  color: #9a8258;
}

.add-btn,
.accept-btn {
  background: #a8322a;
  color: #fff6e2;
}

.reject-btn,
.remove-btn {
  background: #f3ecdb;
  color: #8a7658;
  border: 1rpx solid rgba(184, 134, 11, 0.25);
}

/* 申请与好友列表 */
.friend-row {
  padding: 20rpx 0;
  border-bottom: 1rpx dashed rgba(184, 134, 11, 0.22);
}

.friend-row:last-child {
  border-bottom: none;
}

.rank-badge {
  width: 34rpx;
  flex-shrink: 0;
  text-align: center;
  font-family: "kaiTi", "STKaiti", serif;
  font-size: 26rpx;
  color: #b8860b;
}

.empty-state {
  padding: 40rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: #9a8258;
}
