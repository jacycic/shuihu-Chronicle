<view class="container">
  <text>由于微信有限制导致思考时间最多60s,建议在问题前加“简要”关键字</text>
  <scroll-view scroll-y class="chat-box">
    <view wx:for="{{messages}}" wx:key="index" class="msg-item {{item.role === 'user' ? 'user-row' : 'ai-row'}}">
      <view wx:if="{{item.role === 'assistant'}}" class="avatar ai-avatar">🤖</view>
      <view class="msg">{{item.content}}</view>
      <view wx:if="{{item.role === 'user'}}" class="avatar user-avatar">😊</view>
    </view>
  </scroll-view>

  <view class="input-bar">
    <button class="btn-clear" bindtap="clearChat">清空</button>
    <input
      class="input-main"
      value="{{inputText}}"
      bindinput="inputChange"
      placeholder="你可以问有关水浒的一切"
    />
    <button class="btn-send" bindtap="send">发送</button>
  </view>
</view>