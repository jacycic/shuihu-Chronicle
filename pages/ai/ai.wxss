page {
  background: #f7f2e6;
}

.ai-page{
  height:100vh;
  box-sizing:border-box;
  display:flex;
  flex-direction:column;
  font-family:"KaiTi","STKaiti",serif;
}

.ai-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16rpx;
  padding:28rpx 32rpx;
  background:linear-gradient(165deg,#221e19,#4a3a27);
  border-bottom-left-radius:28rpx;
  border-bottom-right-radius:28rpx;
}
.ai-title{
  font-size:34rpx;
  font-weight:bold;
  letter-spacing:4rpx;
  color:#f7ecd2;
}
.ai-sub{
  margin-top:8rpx;
  font-size:22rpx;
  letter-spacing:2rpx;
  color:#d9b96c;
}
.ai-header-actions{
  flex-shrink:0;
  display:flex;
  align-items:center;
  gap:12rpx;
}
.ai-clear{
  padding:8rpx 18rpx;
  border-radius:999rpx;
  border:1rpx solid rgba(217,185,108,0.5);
  color:#e8d3a0;
  font-size:20rpx;
  white-space:nowrap;
}
.ai-clear-hover{ background:rgba(217,185,108,0.18); }
.ai-mode{
  padding:12rpx 32rpx;
  background:#f0e6cc;
  color:#8a6a34;
  font-size:21rpx;
  letter-spacing:1rpx;
}
.ai-error{
  padding:10rpx 32rpx 14rpx;
  background:#f7e6da;
  color:#a8322a;
  font-size:21rpx;
  line-height:1.6;
}

.ai-scroll{
  flex:1;
  min-height:0;
  box-sizing:border-box;
  padding:24rpx 28rpx;
}
.ai-list{
  display:flex;
  flex-direction:column;
  gap:26rpx;
  padding-bottom:20rpx;
}
.ai-row{ display:flex; justify-content:flex-start; }
.ai-row.mine{ justify-content:flex-end; }
.ai-bubble{
  max-width:78%;
  padding:22rpx 26rpx;
  border-radius:18rpx;
  border:1rpx solid rgba(184,134,11,0.24);
  background:#fffdf7;
  box-shadow:0 6rpx 18rpx rgba(90,70,40,0.08);
  font-size:27rpx;
  line-height:1.75;
  color:#3b2f22;
  white-space:pre-wrap;
  word-break:break-all;
}
.ai-bubble.mine{
  background:linear-gradient(135deg,#8f2c22,#b8860b);
  color:#fff6e2;
  border:none;
}
.ai-bubble.pending{ color:#9a8258; }
.ai-source{
  margin-top:12rpx;
  text-align:right;
  font-size:19rpx;
  color:#a08d6c;
  letter-spacing:1rpx;
}

.ai-quick{
  white-space:nowrap;
  padding:16rpx 24rpx;
  border-top:1rpx solid rgba(184,134,11,0.2);
  background:#faf5e8;
}
.ai-chip{
  display:inline-block;
  margin-right:16rpx;
  padding:12rpx 22rpx;
  border-radius:999rpx;
  border:1rpx solid rgba(168,50,42,0.3);
  background:#fffdf7;
  color:#8f2c22;
  font-size:23rpx;
}
.ai-chip-hover{ background:#f3e2c9; }

.ai-input-bar{
  display:flex;
  align-items:center;
  gap:16rpx;
  padding:18rpx 24rpx 8rpx;
  background:#fffdf7;
  border-top:1rpx solid rgba(184,134,11,0.22);
}
.ai-input{
  flex:1;
  min-width:0;
  height:76rpx;
  padding:0 24rpx;
  border-radius:999rpx;
  background:#f3ecdb;
  font-size:26rpx;
  color:#3b2f22;
}
.ai-placeholder{ color:#a89a7e; }
.ai-send{
  flex-shrink:0;
  height:76rpx;
  line-height:76rpx;
  padding:0 32rpx;
  border-radius:999rpx;
  background:#8f2c22;
  color:#fff5e0;
  font-size:26rpx;
  letter-spacing:2rpx;
}
.ai-send.disabled{ opacity:0.45; }
.ai-send-hover{ opacity:0.85; }
.ai-disclaimer{
  padding:8rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background:#fffdf7;
  text-align:center;
  font-size:19rpx;
  color:#b3a487;
}
