page {
  background: #f7f7f7;
}
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 20rpx;
  box-sizing: border-box;
  background: #fff;
}
.chat-box {
  flex: 1;
  overflow-y: auto;
}
.msg-item {
  display: flex;
  margin: 24rpx 0;
  align-items: flex-start;
  gap: 16rpx;
}
.ai-row {
  flex-direction: row;
}
.user-row {
  flex-direction: row;
  justify-content: flex-end;
}
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e8e8e8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}
.msg {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  max-width: 65%;
  background: #f1f1f1;
  white-space: pre-wrap;
  font-size: 28rpx;
  line-height: 1.5;
}
.user-row .msg {
  background: #07c160;
  color: #ffffff;
}
.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top:20rpx;
  border-top:1rpx solid #eee;
}
/* 重点：输入框加高！min-height 调到120rpx，内边距加大 */
.input-main {
  flex: 1;
  border: 1rpx solid #d9d9d9;
  border-radius: 40rpx;
  padding: 32rpx 28rpx;
  font-size: 32rpx;
  background: #f5f5f5;
  min-height: 120rpx;
  box-sizing: border-box;
}
.btn-clear,
.btn-send {
  /* 按钮固定宽度，不会拉伸挤占输入框 */
  flex: 0 0 130rpx;
  height: 96rpx;
  line-height:96rpx;
  border-radius: 48rpx;
  font-size:28rpx;
  padding:0 !important;
  margin:0 !important;
}
.btn-clear {
  background: #f0f0f0;
  color:#333;
}
.btn-send {
  background:#07c160;
  color:#fff;
}