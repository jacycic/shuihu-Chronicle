<globaltips id="unlockTipRef"></globaltips>
<view class="page">
  <!-- 顶部背景图（和首页梁山雪景保持一致） -->
  <image class="bg-img" src="" mode="aspectFill"></image>
  

  <view class="container">
    <!-- 头部用户信息卡片 -->
    <view class="user-card">
      <!-- 头像：chooseAvatar 更换头像 -->
      <view class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
      </view>
      <view class="user-info">
        <view class="nickname">{{nickname}}</view>
        <view class="desc">梁山好汉收集者</view>
      </view>
    </view>

    <!-- 数据统计卡片 -->
    <view class="stat-card">
      <view class="stat-item">
        <view class="num">{{collectCount}}</view>
        <view class="label">已收集好汉</view>
      </view>
      <view class="stat-item">
        <view class="num">{{achievementCount}}</view>
        <view class="label">解锁成就</view>
      </view>
      <view class="stat-item">
        <view class="num">{{total}}</view>
        <view class="label">总好汉</view>
      </view>
    </view>

    <!-- 功能菜单列表 -->
    <view class="menu-card">
      <view class="menu-item" bindtap="clearAvatar">
        <text>重置头像</text>
        <text class="arrow">></text>
      </view>
      <view class="menu-item" bindtap="editNickname">
        <text>修改昵称</text>
        <text class="arrow">></text>
      </view>
      <view class="menu-item" bindtap="goAchievements">
        <text>我的成就</text>
        <text class="arrow">></text>
      </view>
      <view class="menu-item" bindtap="goCodex">
        <text>好汉图鉴</text>
        <text class="arrow">></text>
      </view>
    </view>

    <!-- 关于 -->
    <view class="about-card">
      <text class="about-text">水浒传好汉图鉴 · 版本1.5.0</text>
    </view>
  </view>
</view>